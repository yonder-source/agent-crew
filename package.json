{
	"name": "agent-crew",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"clean": "node scripts/clean.mjs",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint src tests scripts",
		"test": "npm run build && node --import tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
		"check": "npm run lint && npm run typecheck && npm test",
		"start": "node scripts/start.mjs",
		"dev": "node scripts/start.mjs --import tsx --watch src/main.ts"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"pino": "10.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.20.5",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	}
}
